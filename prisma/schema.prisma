generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////
// AUTH MODELS
//////////////////////

model User {
  id            String    @id @default(cuid())
  firstName     String?
  lastName      String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?

  accounts Account[]
  sessions Session[]

  subscription UserSubscription?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

//////////////////////
// BILLING MIRROR
//////////////////////

enum Plan {
  free_trial
  basic
  pro
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  incomplete
}

/**
 * Local mirror of the Stripe billing service.
 * Stripe app remains the source of truth.
 */
model UserSubscription {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * Stripe app references
   */
  stripeCustomerId     String
  stripeSubscriptionId String

  /**
   * Copied from Stripe app Subscription
   */
  plan   Plan
  status SubscriptionStatus

  /**
   * Optional but recommended:
   * used for fast feature-gating without network calls
   */
  accessEndsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
